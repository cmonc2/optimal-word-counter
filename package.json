{
  "name": "optimal-word-counter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Simon Rotjes (https://github.com/cmonc2)",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"pnpm start:server\" \"pnpm --filter client dev\"",
    "start:server": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "pnpm --filter client build && tsc",
    "lint": "eslint .",
    "test": "vitest run && pnpm --filter client test",
    "test:server": "vitest run",
    "test:client": "pnpm --filter client test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-openapi-validator": "^4.13.8",
    "line-reader": "^0.4.0",
    "multer": "^1.4.5-lts.1",
    "swagger-ui-express": "^5.0.1",
    "timsort": "^0.3.0",
    "yamljs": "^0.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/express": "^4.17.21",
    "@types/line-reader": "^0.0.34",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/yamljs": "^0.2.34",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "lorem-ipsum": "^2.0.8",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.7"
  }
}
